# Copy to .env and edit. Nothing here is secret -- there are no API keys in IBKR's model,
# the gateway is authenticated by you logging into it.

# IB Gateway / TWS socket. 7497 = paper, 7496 = live.
# Start on paper until the numbers have been verified against TWS on screen.
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=17

# Market data type: 1 = live, 2 = frozen, 3 = delayed, 4 = delayed-frozen.
# Options quotes (OPRA) are a paid subscription; without it use 3. On 3 IBKR sends
# bid/ask but no Greeks, so the app computes delta/IV locally from the delayed mid
# (COMPUTE_GREEKS_WHEN_MISSING in config.py) and labels them "computed" in the UI.
# Switch to 1 once the Value Bundle + OPRA subscriptions are active.
IB_MARKET_DATA_TYPE=3

# Account sizing -- drives the position-size and premium-budget rules.
NET_LIQUIDATION=100000
CASH_AVAILABLE=50000

DATABASE_URL=sqlite:///./screener.db
LOG_LEVEL=INFO
